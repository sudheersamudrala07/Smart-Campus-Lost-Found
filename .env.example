# Local development settings. Configure real values in your hosting provider.
NODE_ENV=development
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=smart_campus_app
DB_PASSWORD=replace_with_a_database_password
DB_NAME=smart_campus_db

# Required in production. Use a unique random value of at least 32 characters.
SESSION_SECRET=replace_with_a_long_random_secret

# Optional first-run administrator account. Use a strong unique password.
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@your-campus.edu
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_chars
